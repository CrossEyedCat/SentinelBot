<?xml version="1.0"?>
<sdf version="1.8">
  <world name="default">
    <!-- SentinelBot Mk II arena: TurtleBot3 world geometry, wrench-driven holonomic base (see mecanum_base_sim) -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"></plugin>
    <!-- resultant force of the mecanum wheels is applied by mecanum_base_sim through this system -->
    <plugin filename="gz-sim-apply-link-wrench-system" name="gz::sim::systems::ApplyLinkWrench"></plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Ground Plane</uri>
    </include>

    <include>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Sun</uri>
    </include>

    <!-- generated by tools/make_worlds.py: corridors -->
    <model name="wall_n"><static>true</static><pose>0.000 2.550 0.300 0 0 0.0000</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5.200 0.100 0.600</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5.200 0.100 0.600</size></box></geometry><material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.55 0.57 0.60 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_s"><static>true</static><pose>0.000 -2.550 0.300 0 0 0.0000</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>5.200 0.100 0.600</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>5.200 0.100 0.600</size></box></geometry><material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.55 0.57 0.60 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_e"><static>true</static><pose>2.550 0.000 0.300 0 0 0.0000</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.100 5.000 0.600</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.100 5.000 0.600</size></box></geometry><material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.55 0.57 0.60 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_w"><static>true</static><pose>-2.550 0.000 0.300 0 0 0.0000</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.100 5.000 0.600</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.100 5.000 0.600</size></box></geometry><material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.55 0.57 0.60 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_a"><static>true</static><pose>-0.700 -0.750 0.300 0 0 0.0000</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.100 3.500 0.600</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.100 3.500 0.600</size></box></geometry><material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.55 0.57 0.60 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_b"><static>true</static><pose>0.700 0.750 0.300 0 0 0.0000</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.100 3.500 0.600</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.100 3.500 0.600</size></box></geometry><material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.55 0.57 0.60 1</diffuse></material></visual>
      </link>
    </model>
    <model name="column_1"><static>true</static><pose>-1.625 -1.400 0.300 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.150</radius><length>0.600</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.150</radius><length>0.600</length></cylinder></geometry><material><ambient>0.80 0.30 0.25 1</ambient><diffuse>0.80 0.30 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <model name="column_2"><static>true</static><pose>-1.625 1.400 0.300 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.150</radius><length>0.600</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.150</radius><length>0.600</length></cylinder></geometry><material><ambient>0.80 0.30 0.25 1</ambient><diffuse>0.80 0.30 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <model name="column_3"><static>true</static><pose>1.625 -1.400 0.300 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.150</radius><length>0.600</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.150</radius><length>0.600</length></cylinder></geometry><material><ambient>0.80 0.30 0.25 1</ambient><diffuse>0.80 0.30 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <model name="column_4"><static>true</static><pose>1.625 1.400 0.300 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.150</radius><length>0.600</length></cylinder></geometry></collision>
        <visual name="v"><geometry><cylinder><radius>0.150</radius><length>0.600</length></cylinder></geometry><material><ambient>0.80 0.30 0.25 1</ambient><diffuse>0.80 0.30 0.25 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
