<?xml version="1.0"?>
<model>
  <name>sentinel_mk2</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Artem Zenkevich</name>
    <email>110236400+CrossEyedCat@users.noreply.github.com</email>
  </author>
  <description>
    SentinelBot Mk II: omnidirectional (4x mecanum) FSM patrol robot. Visual geometry exported from the
    Fusion 360 design; sensors: 360 deg LiDAR, 4 ultrasonic, 4 IR, IMU. The base is a free dynamic body;
    the resultant wheel force/torque is applied by the mecanum_base_sim node through the ApplyLinkWrench
    world system (roller physics is not simulated).
  </description>
</model>
