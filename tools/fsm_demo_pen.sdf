<?xml version="1.0"?>
<!-- Four static walls around the robot for tools/fsm_demo.py, 0.84 m inside: every side is inside the
     0.70 m clearance the avoidance needs, so the episode runs past its 10 s limit (ALERT, STUCK). -->
<sdf version="1.9">
  <model name="pen">
    <static>true</static>
    <link name="link">
      <collision name="n"><pose>0.445 0 0.15 0 0 0</pose><geometry><box><size>0.05 0.94 0.3</size></box></geometry></collision>
      <collision name="s"><pose>-0.445 0 0.15 0 0 0</pose><geometry><box><size>0.05 0.94 0.3</size></box></geometry></collision>
      <collision name="e"><pose>0 0.445 0.15 0 0 0</pose><geometry><box><size>0.84 0.05 0.3</size></box></geometry></collision>
      <collision name="w"><pose>0 -0.445 0.15 0 0 0</pose><geometry><box><size>0.84 0.05 0.3</size></box></geometry></collision>
      <visual name="vn"><pose>0.445 0 0.15 0 0 0</pose><geometry><box><size>0.05 0.94 0.3</size></box></geometry>
        <material><ambient>0.7 0.2 0.2 1</ambient><diffuse>0.85 0.25 0.25 1</diffuse></material></visual>
      <visual name="vs"><pose>-0.445 0 0.15 0 0 0</pose><geometry><box><size>0.05 0.94 0.3</size></box></geometry>
        <material><ambient>0.7 0.2 0.2 1</ambient><diffuse>0.85 0.25 0.25 1</diffuse></material></visual>
      <visual name="ve"><pose>0 0.445 0.15 0 0 0</pose><geometry><box><size>0.84 0.05 0.3</size></box></geometry>
        <material><ambient>0.7 0.2 0.2 1</ambient><diffuse>0.85 0.25 0.25 1</diffuse></material></visual>
      <visual name="vw"><pose>0 -0.445 0.15 0 0 0</pose><geometry><box><size>0.84 0.05 0.3</size></box></geometry>
        <material><ambient>0.7 0.2 0.2 1</ambient><diffuse>0.85 0.25 0.25 1</diffuse></material></visual>
    </link>
  </model>
</sdf>
